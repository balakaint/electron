{
  "name": "habit-os",
  "version": "0.1.0",
  "description": "Electron + Python desktop app (migrated from Tkinter)",
  "main": "dist/electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "tsc -p electron/tsconfig.json && wait-on http://localhost:5173 && electron dist/electron/main.js",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "test:window-state": "esbuild electron/window-state.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/wt.cjs --alias:electron=./electron/electron-stub.cjs && node node_modules/.cache/wt.cjs",
    "test:themes": "esbuild electron/themes.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/th.cjs --alias:electron=./electron/electron-stub.cjs && node node_modules/.cache/th.cjs",
    "test:palette": "esbuild renderer/src/palette.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/pal.cjs && node node_modules/.cache/pal.cjs",
    "test:format": "esbuild renderer/src/format.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/fmt.cjs && node node_modules/.cache/fmt.cjs",
    "test:panel-sync": "esbuild renderer/src/panel-sync.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/ps.cjs && node node_modules/.cache/ps.cjs",
    "test:api-retry": "esbuild renderer/src/services/api-retry.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/rt.cjs && node node_modules/.cache/rt.cjs",
    "audit": "npm run build:renderer && node tests/ux-audit.mjs",
    "test:spacing": "node tests/spacing-check.mjs",
    "test:radius": "node tests/radius-check.mjs",
    "test:typography": "node tests/typography-check.mjs",
    "test": "npm run test:spacing && npm run test:radius && npm run test:typography && npm run test:window-state && npm run test:themes && npm run test:palette && npm run test:format && npm run test:panel-sync && npm run test:api-retry",
    "build": "npm run build:renderer && npm run build:electron",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "lucide-react": "^1.47.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.13.0",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.12",
    "playwright-core": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  }
}
